# OrangeHRM Enterprise Automation Framework Configuration
# Copy this file to .env and configure for your local or self-hosted target.

# Application Target
BASE_URL=https://opensource-demo.orangehrmlive.com
ENVIRONMENT=demo

# Authentication Credentials (Default OrangeHRM Demo credentials)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Optional Employee Credentials (if separate account available)
EMPLOYEE_USERNAME=
EMPLOYEE_PASSWORD=

# Browser Execution Settings
BROWSER=chrome
HEADLESS=true
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# Timeouts & Synchronization (seconds)
DEFAULT_TIMEOUT=15
PAGE_LOAD_TIMEOUT=60
IMPLICIT_WAIT=0

# Concurrency & Reporting
WORKERS=2
LOG_LEVEL=INFO
SCREENSHOT_ON_FAILURE=true
CAPTURE_NETWORK_LOGS=false
SAVE_ALLURE_RESULTS=true
